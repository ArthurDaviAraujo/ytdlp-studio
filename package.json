{
  "name": "yt-dlp-gui",
  "productName": "yt-dlp GUI",
  "version": "1.5.1",
  "description": "Interface gráfica para o yt-dlp",
  "main": "./out/main/index.js",
  "author": "Arthur Davi",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "dev.arthurdavi.ytdlpgui",
    "productName": "yt-dlp GUI",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/onnxruntime-node/script/**"
    ],
    "extraResources": [
      {
        "from": "../programas/yt-dlp.exe",
        "to": "bin/yt-dlp.exe"
      },
      {
        "from": "../programas/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "../programas/ffprobe.exe",
        "to": "bin/ffprobe.exe"
      },
      {
        "from": "../programas/deno.exe",
        "to": "bin/deno.exe"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "@mediapipe/tasks-vision": "^1.2.2"
  },
  "dependencies": {
    "lucide-react": "^1.65.0",
    "onnxruntime-node": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
